# Copy this file to .env.local and fill in your project values.

# --- Supabase --------------------------------------------------------------
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Settings -> API -> Project API keys -> service_role (secret!).
# Server-only — used to mark an order "paid" after Razorpay signature
# verification. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Razorpay (test mode) ---------------------------------------------------
# Dashboard -> Settings -> API Keys -> Generate Test Key.
# Server-only:
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
# Same key id, exposed to the client to open the Checkout.js sheet:
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
